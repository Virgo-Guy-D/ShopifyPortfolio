# Copy this file to `.env` and fill in the values, then restart the API.
#
# These are read by the Express server only. Unlike Vite's `VITE_*` variables,
# nothing here is bundled into the browser build — the API key stays on the server.
#
# Optional settings are left commented rather than blank on purpose: an assigned
# but empty value is still a value. server/config.ts treats blanks as unset, but
# commenting them out keeps the intent obvious.

# API key from https://resend.com (Dashboard → API Keys). Without it the server
# still runs, but reports itself unconfigured and the form falls back to opening
# the visitor's mail client.
RESEND_API_KEY=

# Where submissions are delivered. Defaults to arthurparadizi77825@gmail.com.
# CONTACT_TO=

# The From: address. Resend only accepts a domain verified in their dashboard.
# Left unset it uses `onboarding@resend.dev`, Resend's shared sender, which needs
# no DNS setup but only delivers to the address that owns the API key — fine while
# that address is also the recipient above. Verify your own domain before sending
# anywhere else.
# CONTACT_FROM=

# Port the API listens on. Must match the proxy target in vite.config.ts.
# PORT=3001

# Messages accepted per IP per hour. Defaults to 5 in production and 100 in
# development, where every request shares the 127.0.0.1 bucket.
# CONTACT_RATE_LIMIT=
